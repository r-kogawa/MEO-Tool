{
  "name": "MEO-Tool",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "dev:emulator": "bash scripts/dev-emulator.sh",
    "dev:firebase": "NUXT_PUBLIC_USE_MOCK=false NUXT_PUBLIC_USE_EMULATOR=false nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "test:emulator": "firebase emulators:exec --only firestore,storage --project demo-meo-tool \"npm --prefix functions run test:emulator\""
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "nuxt": "^4.5.2",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/qrcode": "^1.5.6",
    "typescript": "~5.9",
    "vue-tsc": "^3.3.11"
  }
}
