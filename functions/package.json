{
  "name": "functions",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "tsc -p tsconfig.test.json && node --test \"lib-test/**/__tests__/*.test.js\"",
    "rank:probe": "tsc -p tsconfig.test.json && node lib-test/rankings/__tests__/probe.js",
    "test:emulator": "tsc -p tsconfig.test.json && node --test --test-concurrency=1 \"lib-test/**/__tests__/*.itest.js\""
  },
  "engines": {
    "node": "24"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@google-cloud/kms": "^5.7.0",
    "@sparticuz/chromium": "153.0.0",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.0",
    "google-auth-library": "^10.9.1",
    "nodemailer": "^10.0.16",
    "puppeteer-core": "25.11.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/nodemailer": "^8.0.2",
    "firebase": "^12.19.0",
    "firebase-functions-test": "^3.4.1",
    "typescript": "^6.0.0"
  },
  "private": true
}
